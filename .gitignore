# 浏览器自动化临时截图
.screenshots/

# 用户隐私数据（灵感 JSON 备份绝不进公开仓库）
backups/data/*.json
backups/data/*.md

# 系统垃圾
Thumbs.db
desktop.ini
.DS_Store

# Trae 本地配置/技能（含本机路径，不进公开仓库）
.trae/

# 课程提交包（本地材料，不进公开仓库）
提交/

# Word 为提交前由 md 临时生成的成品，不长期保留（md2docx.py 按需生成）
*.docx

# 视频抽帧等临时工作目录
.tmp_frames/

# WorkBuddy 本地项目数据（记忆、缓存）
.workbuddy/

# 本地预览副本（含演示数据，不发布）
app/_preview.html
# 外部参考资料与设计探索稿
.tmp_refs/
.tmp_frames/
design/
backups/code/
